{
  "name": "@llblab/pi-kit",
  "version": "0.23.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Version-pinned distribution of LLB Lab extensions and Skills for Pi",
  "keywords": [
    "pi-package",
    "pi",
    "extensions",
    "kit",
    "llblab"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/llblab/pi-kit.git"
  },
  "homepage": "https://github.com/llblab/pi-kit",
  "bugs": {
    "url": "https://github.com/llblab/pi-kit/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "audit": "npm audit --omit=dev",
    "pack:check": "npm pack --dry-run",
    "validate": "npm test && npm run audit && npm run pack:check"
  },
  "files": [
    "README.md",
    "AGENTS.md",
    "BACKLOG.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@llblab/pi-actors": "0.53.2",
    "@llblab/pi-clean-room": "0.2.0",
    "@llblab/pi-codex-usage": "0.10.0",
    "@llblab/pi-grow-loop": "0.8.2",
    "@llblab/pi-state-flow": "0.19.0",
    "@llblab/pi-telegram": "0.51.4",
    "@llblab/skills": "1.15.0"
  },
  "bundledDependencies": [
    "@llblab/pi-actors",
    "@llblab/pi-clean-room",
    "@llblab/pi-codex-usage",
    "@llblab/pi-grow-loop",
    "@llblab/pi-state-flow",
    "@llblab/pi-telegram",
    "@llblab/skills"
  ],
  "pi": {
    "extensions": [
      "./node_modules/@llblab/pi-actors/dist/pi-actors/index.js",
      "./node_modules/@llblab/pi-clean-room/index.ts",
      "./node_modules/@llblab/pi-codex-usage/index.ts",
      "./node_modules/@llblab/pi-grow-loop/dist/pi-grow-loop/index.js",
      "./node_modules/@llblab/pi-state-flow/dist/pi-state-flow/index.js",
      "./node_modules/@llblab/pi-telegram/dist/pi-telegram/index.js"
    ],
    "skills": [
      "./node_modules/@llblab/pi-actors/dist/skills",
      "./node_modules/@llblab/pi-grow-loop/dist/skills",
      "./node_modules/@llblab/pi-state-flow/dist/skills",
      "./node_modules/@llblab/pi-telegram/dist/skills",
      "./node_modules/@llblab/skills/"
    ]
  },
  "bundleDependencies": [
    "@llblab/pi-actors",
    "@llblab/pi-clean-room",
    "@llblab/pi-codex-usage",
    "@llblab/pi-grow-loop",
    "@llblab/pi-state-flow",
    "@llblab/pi-telegram",
    "@llblab/skills"
  ]
}
