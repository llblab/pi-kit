{
  "name": "@llblab/pi-kit",
  "version": "0.38.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Version-pinned distribution of LLB Lab extensions and Skills for Pi",
  "keywords": [
    "pi-package",
    "pi",
    "extensions",
    "kit",
    "llblab"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/llblab/pi-kit.git"
  },
  "homepage": "https://github.com/llblab/pi-kit",
  "bugs": {
    "url": "https://github.com/llblab/pi-kit/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "audit": "npm audit --omit=dev",
    "deps:check": "node scripts/check-updates.mjs",
    "check:coherence": "node scripts/validate.mjs",
    "pack:check": "node scripts/validate.mjs --pack",
    "validate": "npm run check:coherence && npm test && npm run audit && npm run pack:check"
  },
  "files": [
    "extensions/",
    "README.md",
    "AGENTS.md",
    "BACKLOG.md",
    "CHANGELOG.md",
    "LICENSE",
    "banner.jpg"
  ],
  "dependencies": {
    "@llblab/pi-actors": "0.55.0",
    "@llblab/pi-claude-usage": "0.2.3",
    "@llblab/pi-clean-room": "0.3.0",
    "@llblab/pi-codex-usage": "0.13.2",
    "@llblab/pi-grow-loop": "0.9.0",
    "@llblab/pi-state-flow": "0.27.1",
    "@llblab/pi-telegram": "0.58.3",
    "@llblab/skills": "1.15.0"
  },
  "bundledDependencies": [
    "@llblab/pi-actors",
    "@llblab/pi-claude-usage",
    "@llblab/pi-clean-room",
    "@llblab/pi-codex-usage",
    "@llblab/pi-grow-loop",
    "@llblab/pi-state-flow",
    "@llblab/pi-telegram",
    "@llblab/skills"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-actors/index.js",
      "./extensions/pi-claude-usage/index.ts",
      "./extensions/pi-clean-room/index.ts",
      "./extensions/pi-codex-usage/index.ts",
      "./extensions/pi-grow-loop/index.js",
      "./extensions/pi-state-flow/index.js",
      "./extensions/pi-telegram/index.js"
    ],
    "skills": [
      "./node_modules/@llblab/pi-actors/dist/skills",
      "./node_modules/@llblab/pi-grow-loop/dist/skills",
      "./node_modules/@llblab/pi-state-flow/dist/skills",
      "./node_modules/@llblab/pi-telegram/dist/skills",
      "./node_modules/@llblab/skills/"
    ],
    "image": "https://raw.githubusercontent.com/llblab/pi-kit/main/banner.jpg"
  },
  "bundleDependencies": [
    "@llblab/pi-actors",
    "@llblab/pi-claude-usage",
    "@llblab/pi-clean-room",
    "@llblab/pi-codex-usage",
    "@llblab/pi-grow-loop",
    "@llblab/pi-state-flow",
    "@llblab/pi-telegram",
    "@llblab/skills"
  ]
}
